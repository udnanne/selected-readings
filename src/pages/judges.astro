<style lang="scss">
.judges {
    text-align: left;
    
    h3 {
        font-weight: normal;
        color: #3B84B7;
        margin: 30px 0 20px 0;
        font-size: 20px;
    }
}

/* 評審委員表格樣式 */
.judges_table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 20px 0;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid #d8d8d8;
    font-size: 18px;
    
    thead tr {
        background-color: #E5F4FF;
    }
    
    th,
    td {
        border: none;
        border-right: 1px solid #d8d8d8;
        border-bottom: 1px solid #d8d8d8;
        padding: 10px;
        text-align: center;
        
        &:last-child {
            border-right: none;
        }
    }
    
    tbody tr:last-child td {
        border-bottom: none;
    }
    
    @media (max-width: 768px) {
        font-size: 14px;
        
        th,
        td {
            padding: 8px 4px;
        }
    }
}

.breadcrumb {
    margin: 20px auto;
    
    nav {
        font-size: 14px;
        color: #666;
        
        a {
            color: #3B84B7;
            text-decoration: none;
            
            &:hover {
                text-decoration: underline;
            }
        }
    }
}
</style>
